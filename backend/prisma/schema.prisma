generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model MemeJob {
  id            String    @id // UUIDv7, generated in service, doubles as session id
  character     String
  language      String    @default("hindi") // 'bhojpuri' | 'kannada' | 'hindi' | ...
  voiceStyle    String    @default("comedy-uncle") // generic style id, never a real person's name
  selfieUrl     String
  voiceUrl      String?
  scriptText    String?
  status        JobStatus @default(PENDING)
  outputUrl     String?
  errorMessage  String?
  watermarked   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}
