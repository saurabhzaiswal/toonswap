generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum CatalogStatus {
  LIVE
  PLANNED
  RESEARCH
  ARCHIVED
}

enum ProjectStatus {
  DRAFT
  PLANNING
  READY
  RENDERING
  COMPLETE
  FAILED
  ARCHIVED
}

enum StudioMode {
  SIMPLE
  CREATOR
}

enum SceneStatus {
  DRAFT
  APPROVED
  QUEUED
  RENDERING
  COMPLETE
  FAILED
}

enum SelfInsertStatus {
  DRAFT
  QUEUED
  PROCESSING
  READY
  FAILED
  DELETED
}

enum SelfInsertVoiceMode {
  AS_IS
  CONVERT
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETION_PENDING
}

enum AgeGateStatus {
  POLICY_REQUIRED
  ELIGIBLE
  GUARDIAN_REQUIRED
  GUARDIAN_APPROVED
}

enum AuthProvider {
  EMAIL_OTP
  GOOGLE
}

enum OtpPurpose {
  LOGIN
  SIGNUP
}

model User {
  id                     String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                  String               @unique @db.VarChar(320)
  emailNormalized        String               @unique @db.VarChar(320)
  emailVerifiedAt        DateTime?
  name                   String?              @db.VarChar(120)
  dateOfBirth            DateTime?            @db.Date
  city                   String?              @db.VarChar(120)
  countryCode            String?              @db.VarChar(2)
  locale                 String?              @db.VarChar(16)
  timezone               String?              @db.VarChar(64)
  avatarObjectKey        String?
  pendingAvatarObjectKey String?
  avatarMimeType         String?              @db.VarChar(80)
  role                   UserRole             @default(USER)
  status                 UserStatus           @default(ACTIVE)
  ageGateStatus          AgeGateStatus        @default(POLICY_REQUIRED)
  profileComplete        Boolean              @default(false)
  termsAcceptedAt        DateTime?
  privacyAcceptedAt      DateTime?
  lastLoginAt            DateTime?
  lastSeenAt             DateTime?
  blockedAt              DateTime?
  blockedReason          String?              @db.VarChar(300)
  deletionRequestedAt    DateTime?
  isSystem               Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  sessions               AuthSession[]
  identities             AuthIdentity[]
  memeJobs               MemeJob[]
  ownedCharacters        Character[]
  storyProjects          StoryProject[]
  consentRecords         ConsentRecord[]
  selfInsertAssets       SelfInsertAsset[]
  usagePolicyOverride    UsagePolicyOverride?
  activityPerformed      ActivityLog[]        @relation("ActivityActor")
  activityReceived       ActivityLog[]        @relation("ActivitySubject")

  @@index([status, lastSeenAt(sort: Desc)])
  @@index([role, status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model AuthIdentity {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerSubject String       @db.VarChar(255)
  providerEmail   String?      @db.VarChar(320)
  lastUsedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId, lastUsedAt(sort: Desc)])
}

model AuthSession {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.VarChar(64)
  csrfTokenHash String    @db.VarChar(64)
  ipHash        String?   @db.VarChar(64)
  userAgent     String?   @db.VarChar(500)
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt, revokedAt])
}

model OtpChallenge {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash       String     @unique @db.VarChar(64)
  requestId       String     @unique @db.Uuid
  emailNormalized String     @db.VarChar(320)
  purpose         OtpPurpose
  codeHash        String     @db.VarChar(64)
  requestIpHash   String?    @db.VarChar(64)
  fingerprintHash String?    @db.VarChar(64)
  attempts        Int        @default(0)
  expiresAt       DateTime
  verified        Boolean    @default(false)
  consumedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([codeHash, tokenHash, requestId])
  @@index([emailNormalized, verified, createdAt(sort: Desc)])
  @@index([emailNormalized, createdAt(sort: Desc)])
  @@index([requestIpHash, createdAt(sort: Desc)])
  @@index([expiresAt, consumedAt])
}

model UsagePolicyOverride {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String   @unique @db.Uuid
  generationLimit Int?
  windowDays      Int?
  unlimited       Boolean  @default(false)
  note            String?  @db.VarChar(300)
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([unlimited, updatedAt(sort: Desc)])
}

model ActivityLog {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId   String?   @db.Uuid
  subjectUserId String?   @db.Uuid
  action        String    @db.VarChar(80)
  entityType    String?   @db.VarChar(80)
  entityId      String?   @db.VarChar(160)
  entityName    String?   @db.VarChar(200)
  description   String?   @db.VarChar(500)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? @db.Timestamp(0)
  actor         User?     @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subject       User?     @relation("ActivitySubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([subjectUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
}

model MemeJob {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @db.Uuid
  character    String
  language     String    @default("hindi") // 'bhojpuri' | 'kannada' | 'hindi' | ...
  voiceStyle   String    @default("comedy-uncle") // generic style id, never a real person's name
  selfieUrl    String
  voiceUrl     String?
  scriptText   String?
  status       JobStatus @default(PENDING)
  outputUrl    String?
  errorMessage String?
  watermarked  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)])
}

model Character {
  id                    String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug                  String           @unique
  name                  String
  worldId               String
  worldName             String
  era                   String
  archetype             String
  personality           String
  movementStyle         Json
  visualBrief           Json
  imageUrl              String?
  thumbnailUrl          String?
  tags                  Json?
  status                CatalogStatus    @default(PLANNED)
  isSystem              Boolean          @default(true)
  ownerUserId           String?          @db.Uuid
  consentRecordId       String?          @db.Uuid
  defaultVoiceProfileId String?          @db.Uuid
  defaultVoiceProfile   VoiceProfile?    @relation("DefaultCharacterVoice", fields: [defaultVoiceProfileId], references: [id], onDelete: SetNull)
  owner                 User?            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  storyCharacters       StoryCharacter[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([worldId, status])
  @@index([ownerUserId])
}

model VoiceProfile {
  id                   String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug                 String           @unique
  name                 String
  languageCode         String
  languageName         String
  region               String
  direction            String
  ageFeel              String?
  genderPresentation   String?
  emotionalRange       Json
  previewUrl           String?
  providerVoiceId      String?
  providerMetadata     Json?
  consentRequired      Boolean          @default(false)
  status               CatalogStatus    @default(RESEARCH)
  defaultForCharacters Character[]      @relation("DefaultCharacterVoice")
  storyCharacters      StoryCharacter[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([languageCode, status])
  @@index([region])
}

model StoryProject {
  id                    String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                String            @db.Uuid
  title                 String
  prompt                String
  worldId               String
  genre                 String
  audience              String
  visualStyle           String
  primaryLanguageCode   String
  targetDurationSeconds Int
  captionsEnabled       Boolean           @default(true)
  mode                  StudioMode        @default(SIMPLE)
  status                ProjectStatus     @default(DRAFT)
  version               Int               @default(1)
  moderationState       Json?
  costEstimate          Json?
  storyCharacters       StoryCharacter[]
  scenes                StoryScene[]
  selfInsertAssets      SelfInsertAsset[]
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
  @@index([status, updatedAt])
}

model StoryCharacter {
  id                String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId         String           @db.Uuid
  characterId       String?          @db.Uuid
  voiceProfileId    String?          @db.Uuid
  selfInsertAssetId String?          @db.Uuid
  role              String
  sortOrder         Int
  customSnapshot    Json?
  direction         Json?
  project           StoryProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character         Character?       @relation(fields: [characterId], references: [id], onDelete: SetNull)
  voiceProfile      VoiceProfile?    @relation(fields: [voiceProfileId], references: [id], onDelete: SetNull)
  selfInsertAsset   SelfInsertAsset? @relation(fields: [selfInsertAssetId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([projectId, sortOrder])
  @@index([characterId])
  @@index([voiceProfileId])
  @@index([selfInsertAssetId])
}

model ConsentRecord {
  id                 String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String            @db.Uuid
  likenessAuthorized Boolean
  voiceAuthorized    Boolean
  retentionAccepted  Boolean
  policyVersion      String
  createdAt          DateTime          @default(now())
  withdrawnAt        DateTime?
  selfInsertAssets   SelfInsertAsset[]
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model SelfInsertAsset {
  id                    String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                String              @db.Uuid
  projectId             String?             @db.Uuid
  consentRecordId       String              @db.Uuid
  displayName           String
  photoSourceUrl        String?
  voiceSourceUrl        String?
  characterReferenceUrl String?
  voiceReferenceUrl     String?
  voiceMode             SelfInsertVoiceMode @default(AS_IS)
  voiceStyle            String?
  status                SelfInsertStatus    @default(DRAFT)
  failureReason         String?
  expiresAt             DateTime
  deletedAt             DateTime?
  project               StoryProject?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  consentRecord         ConsentRecord       @relation(fields: [consentRecordId], references: [id], onDelete: Cascade)
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyCharacters       StoryCharacter[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([projectId])
  @@index([expiresAt, status])
}

model StoryScene {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId         String       @db.Uuid
  sortOrder         Int
  title             String
  durationSeconds   Int
  characters        String
  location          String
  action            String
  dialogue          String?
  expression        String
  camera            String
  audioMode         String
  regenerationScope String
  continuity        String?
  promptSnapshot    Json?
  outputLayers      Json?
  status            SceneStatus  @default(DRAFT)
  version           Int          @default(1)
  project           StoryProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([projectId, sortOrder])
  @@index([projectId, status])
}
