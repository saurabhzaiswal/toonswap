PORT=3000
# Comma-separated exact browser origins. Required in production.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4173

# Authentication. Use a generated value of at least 32 characters in every environment.
AUTH_SECRET=
# Leave blank to default to true in production and false in development.
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAME_SITE=lax
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_WINDOW_MINUTES=15
OTP_REQUEST_LIMIT_PER_EMAIL=3
OTP_REQUEST_LIMIT_PER_IP=10

# Passwordless email delivery (MJML + Nodemailer).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ToonSwap <no-reply@example.com>

# Google Identity Services OAuth client ID. Leave blank to hide Google sign-in.
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile is required for OTP and Google authentication.
# The public site key belongs in frontend/.env as VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
# Verified new accounts on this comma-separated allowlist become administrators.
# Remove the value after bootstrapping and manage later roles in the admin dashboard.
BOOTSTRAP_ADMIN_EMAILS=

# These launch policies are intentionally explicit. Generation fails closed while blank.
MINIMUM_SELF_SERVE_AGE=
FREE_GENERATION_LIMIT=1
FREE_GENERATION_WINDOW_DAYS=
# Set limit to 0 for unlimited admins; still configure the window explicitly (0 = lifetime).
ADMIN_GENERATION_LIMIT=0
ADMIN_GENERATION_WINDOW_DAYS=0

DATABASE_URL=postgresql://user:password@localhost:5432/toonswap

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

REPLICATE_API_TOKEN=
REPLICATE_SELF_INSERT_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_SELF_INSERT_VOICE_MAP={}

# Keep both false until provider contracts, media moderation, cost limits, and retention deletion are verified.
SELF_INSERT_PROVIDER_ENABLED=false
SELF_INSERT_MEDIA_MODERATION_ENABLED=false

S3_REGION=auto
S3_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=toonswap-assets
# Used only for non-sensitive generated outputs. Self-insert sources never use this public origin.
S3_PUBLIC_BASE_URL=https://media-your-project.example
S3_ACCESS_KEY=
S3_SECRET_KEY=
TEMPLATE_ASSET_BASE_URL=https://toonswap-kappa.vercel.app
