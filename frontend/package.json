{
  "name": "toonswap-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-seo.mjs",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,vue,scss,css}\" \"api/**/*.js\" \"scripts/**/*.{js,mjs}\" \"*.{js,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,scss,css}\" \"api/**/*.js\" \"scripts/**/*.{js,mjs}\" \"*.{js,json,html}\"",
    "mobile:sync": "npm run build && cap sync",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@uppy/core": "^5.2.0",
    "@uppy/vue": "^3.2.0",
    "@uppy/xhr-upload": "^5.2.0",
    "@vercel/analytics": "^2.0.1",
    "pinia": "^2.2.2",
    "vue": "^3.4.38",
    "vue-router": "^4.6.4",
    "vue-select": "^4.0.0-beta.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "tailwindcss": "^3.4.10",
    "vite": "^8.2.1"
  }
}
