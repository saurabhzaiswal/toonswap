# Deployed NestJS backend origin, without a trailing slash.
# Leave empty during local development to use Vite's /api proxy.
VITE_API_BASE_URL=

# Public Cloudflare Turnstile widget key. Safe and required in the browser bundle.
VITE_TURNSTILE_SITE_KEY=

# Public Google Identity Services client ID. Enables the official Google button and One Tap prompt.
# Keep the matching GOOGLE_CLIENT_ID on the backend. Google decides whether One Tap can display.
VITE_GOOGLE_CLIENT_ID=

# UI availability flag. Backend SMTP configuration remains authoritative.
VITE_OTP_ENABLED=true

# Server-only Vercel proxy target. Do not prefix with VITE_ and do not include /api.
BACKEND_ORIGIN=http://localhost:3000


VITE_PRODUCTION=false
VITE_GATE_PASSWORD=K7mQ9xR2vL8pN4zT6wY3cF1hJ5sD0aBx