{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/app/characters", "destination": "/app/characters/index.html" },
    { "source": "/app/voices", "destination": "/app/voices/index.html" },
    { "source": "/app/story-studio", "destination": "/app/story-studio/index.html" },
    { "source": "/login", "destination": "/login/index.html" },
    { "source": "/signup", "destination": "/signup/index.html" },
    { "source": "/app/profile", "destination": "/app/profile/index.html" },
    { "source": "/app/admin", "destination": "/app/admin/index.html" },
    { "source": "/roadmap", "destination": "/roadmap/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    {
      "source": "/blog/original-characters-without-copying",
      "destination": "/blog/original-characters-without-copying/index.html"
    },
    {
      "source": "/blog/directing-comedy-across-languages",
      "destination": "/blog/directing-comedy-across-languages/index.html"
    },
    {
      "source": "/blog/scene-by-scene-animation-workflow",
      "destination": "/blog/scene-by-scene-animation-workflow/index.html"
    },
    {
      "source": "/blog/consent-first-family-stories",
      "destination": "/blog/consent-first-family-stories/index.html"
    },
    {
      "source": "/blog/designing-stone-to-space-worlds",
      "destination": "/blog/designing-stone-to-space-worlds/index.html"
    },
    {
      "source": "/blog/one-hour-animation-cost-plan",
      "destination": "/blog/one-hour-animation-cost-plan/index.html"
    },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    {
      "source": "/community-guidelines",
      "destination": "/community-guidelines/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    }
  ]
}
